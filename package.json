{
  "name": "training-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline PWA for a strength + hypertrophy + 10K running program. Zero runtime dependencies — devDependencies are for testing only and are never shipped.",
  "scripts": {
    "test": "node --test tests/unit/",
    "test:e2e": "playwright test",
    "serve": "node tools/serve.mjs",
    "build:sw": "node tools/gen-sw-manifest.mjs",
    "check:sw": "node tools/gen-sw-manifest.mjs --check",
    "verify": "npm run check:sw && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "fake-indexeddb": "^6.0.0"
  }
}
